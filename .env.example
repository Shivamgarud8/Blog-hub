# ====================================================================
# BloomScript - Full-Stack AI Blog Generator Environment Configuration
# ====================================================================

# 1. PostgreSQL 18 Database Credentials
POSTGRES_DB=blog_gen
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=change_this_strong_password_in_production
DATABASE_URL=postgresql+psycopg://blog_user:change_this_strong_password_in_production@postgres:5432/blog_gen

# 2. JWT Authentication Secrets
JWT_SECRET_KEY=change_this_to_a_long_random_64_character_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. AI Provider Configuration (OpenAI, OpenRouter, Groq, Ollama, DeepSeek, or Gemini)
# Leave blank to automatically use the smart offline generation engine
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 4. Featured Image Generation API
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# 5. Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 6. Frontend API Connection URL
VITE_API_URL=http://localhost:8000
